# Environment variables for the Integrations service
# HighLevel OAuth and webhook configuration for testing purposes
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
HIGHLEVEL_REDIRECT_URL=
# Used to verify HighLevel webhook requests
HIGHLEVEL_SSO_KEY=
# AES key used to encrypt provider tokens at rest
TOKEN_ENCRYPTION_KEY=
env=
LOG_LEVEL=debug
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
DB_TLS_DISABLED=
RUN_MIGRATIONS=
MIGRATION_PATH=
LISTEN_PORT=
# HTTP gateway and webhook port, defaults to 8080
PORT=