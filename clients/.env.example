# Environment variables for Clients service
# Copy this file to .env and fill in your values

# Logging
LOG_LEVEL=info

# gRPC server
LISTEN_PORT=50051

# HTTP gateway
PORT=8080

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clients
DB_TLS_DISABLED=true

# Migrations
RUN_MIGRATIONS=true
MIGRATION_PATH=db/migrations

# HighLevel OAuth provider
HIGHLEVEL_CLIENT_ID=
HIGHLEVEL_CLIENT_SECRET=
HIGHLEVEL_REDIRECT_URI=https://api.rvpay.com/v1/public/oauth/callback

# HighLevel webhooks
WEBHOOK_SECRET=